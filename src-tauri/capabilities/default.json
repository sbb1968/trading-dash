{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://127.0.0.1:8000/*" },
        { "url": "http://localhost:8000/*" },
        { "url": "http://192.168.8.16:8000/*" },
        { "url": "https://*/*" },
        { "url": "http://*/*" }
      ]
    }
  ]
}