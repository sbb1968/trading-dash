//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  RVOL Oscillator — relativ volumen som MACD-agtigt soejlediagram
// ════════════════════════════════════════════════════════════════════════════
//  Nulpunktet er RVOL = 1 (volumen praecis som gennemsnittet).
//  Soejlen viser afvigelsen fra gennemsnittet som FORHOLDSTAL:
//      RVOL 2.00  ->  +1.00   (dobbelt volumen — groen, over nul)
//      RVOL 1.50  ->  +0.50
//      RVOL 1.00  ->   0.00   (nullinjen)
//      RVOL 0.60  ->  -0.40   (roed, under nul)
//
//  Farvelaegningen efterligner MACD-histogrammet: kraftig farve naar soejlen
//  vokser vaek fra nul, daempet naar den er paa vej tilbage mod nul.
//
//  Standardindstillingen (20 perioder, SMA, aktuel bar udeladt) matcher den
//  RVOL vi brugte i MES-analysen — verificeret bit-identisk mod
//  store_bevaegelser_lib.rvol() — saa vaerdier i charten kan sammenlignes
//  direkte med tallene i datasaettet.
// ════════════════════════════════════════════════════════════════════════════
indicator("RVOL Oscillator", shorttitle="RVOL Osc", precision=2)

// Pine tillader ikke en collection direkte i en anden collections type-template
// (`map<int, array<float>>` giver CE10025). Arrayet pakkes derfor i en
// user-defined type, som map'et saa kan holde.
type Spor
    array<float> vol

// ── Beregning ───────────────────────────────────────────────────────────────
metode = input.string("Foregaaende barer", "Sammenlign med",
     options=["Foregaaende barer", "Samme tidspunkt tidligere dage"], group="Beregning",
     tooltip="Foregaaende barer: klassisk rullende snit — matcher MES-analysen, men " +
             "paa intradag maaler den delvist HVAD KLOKKEN ER, fordi volumen foelger " +
             "en fast doegnrytme. Samme tidspunkt: sammenligner denne bar med samme " +
             "klokkeslet paa tidligere dage, saa doegnrytmen falder ud.")
len    = input.int(20, "Perioder i volumen-snittet", minval=1, group="Beregning",
     tooltip="Antal bars (Foregaaende barer) eller antal DAGE (Samme tidspunkt).")
maType = input.string("SMA", "Type gennemsnit", options=["SMA", "EMA"], group="Beregning",
     tooltip="Bruges kun ved 'Foregaaende barer'.")
excl   = input.bool(true, "Udelad den aktuelle bar fra snittet", group="Beregning",
     tooltip="Til: baren sammenlignes med de FOREGAAENDE bars — en volumen-eksplosion " +
             "traekker ikke sit eget sammenligningsgrundlag op. Fra: baren indgaar i sit " +
             "eget snit og fremstaar mindre usaedvanlig end den er.")
minDage = input.int(5, "Min. dage foer 'Samme tidspunkt' er gyldig", minval=1, group="Beregning")

// ── Visning ─────────────────────────────────────────────────────────────────
skala = input.string("Forholdstal", "Skala",
     options=["Forholdstal", "Log2 (doblinger)"], group="Visning",
     tooltip="Forholdstal (rvol-1): raat og let at laese — men skalaen er skaev. " +
             "Volumen kan ikke blive negativ, saa nedadgaaende barer er klemt " +
             "sammen mellem 0 og -1, mens opadgaaende er ubegraensede. Paa MES " +
             "fylder opsiden 83 % af aksen.\n\n" +
             "Log2: én enhed = en dobling. Halv volumen = -1, dobbelt = +1, " +
             "fire gange = +2. Symmetrisk om nul og langt nemmere at aflaese " +
             "paa den lave side.")
visSignal = input.bool(false, "Vis signallinje (som MACD)", group="Visning")
sigLen    = input.int(9, "Signallinje-laengde", minval=1, group="Visning")
visNiv    = input.bool(true, "Vis taerskellinjer", group="Visning")
niv1      = input.float(1.5, "Taerskel 1 (RVOL)", step=0.1, minval=0.1, group="Visning",
     tooltip="1.5 = signaturens 'hoej RVOL' fra MES-analysen. Tegnes ved +0.50.")
niv2      = input.float(4.0, "Taerskel 2 (RVOL)", step=0.1, minval=0.1, group="Visning",
     tooltip="4.0 = hale-filteret fra MES-analysen. Tegnes ved +3.00.")

// ── Grundlaget: rullende snit ───────────────────────────────────────────────
// excl=true  ->  snit af de FOREGAAENDE `len` bars (volume[1] .. volume[len])
// excl=false ->  snit inkl. den aktuelle bar
grundlag  = excl ? volume[1] : volume
snitRull  = maType == "SMA" ? ta.sma(grundlag, len) : ta.ema(grundlag, len)

// ── Grundlaget: samme tidspunkt tidligere dage ──────────────────────────────
// Volumen foelger en fast doegnrytme (aabning hoej, midt paa dagen lav). Et
// rullende snit sammenligner derfor aabningsbaren med nattetimer, og RVOL
// maaler mest hvad klokken er. Her holdes i stedet ét volumen-arkiv pr.
// klokkeslet, saa baren sammenlignes med SIG SELV paa tidligere dage.
//
// Noeglen er minut-paa-doegnet i symbolets egen tidszone. Det haandterer
// helligdage og forskellig sessionslaengde af sig selv — modsat en
// "bars pr. dag"-udregning, der skrider hver gang en dag er kortere.
var map<int, Spor> arkiv = map.new<int, Spor>()

noegle = timeframe.isintraday
     ? hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
     : 0
spor = map.get(arkiv, noegle)
if na(spor)
    spor := Spor.new(array.new<float>())
    map.put(arkiv, noegle, spor)

// Snittet laeses FOER dagens volumen laegges i arkivet — saa den aktuelle bar
// aldrig indgaar i sit eget sammenligningsgrundlag.
snitSlot = array.size(spor.vol) >= minDage ? array.avg(spor.vol) : na
if barstate.isconfirmed and not na(volume) and volume > 0
    array.push(spor.vol, volume)
    if array.size(spor.vol) > len
        array.shift(spor.vol)

snit = metode == "Foregaaende barer" ? snitRull : snitSlot

// Guard: uden volumen-data (eller et snit paa nul) er RVOL udefineret — na
// giver et hul i plottet frem for et vildledende tal.
rvol = not na(snit) and snit > 0 ? volume / snit : na

// Afvigelsen fra gennemsnittet. Begge skalaer har nul ved RVOL = 1.
//   Forholdstal : RVOL 1.5 -> +0.50   RVOL 0.6 -> -0.40   (gulv ved -1)
//   Log2        : RVOL 2.0 -> +1.00   RVOL 0.5 -> -1.00   (symmetrisk)
// log kraever et positivt argument — en bar helt uden volumen giver na.
osc = skala == "Forholdstal" ? rvol - 1
     : (not na(rvol) and rvol > 0 ? math.log(rvol) / math.log(2) : na)

// ── Farver — samme logik som MACD-histogrammet ──────────────────────────────
// Kraftig naar soejlen vokser (vaek fra nul), daempet naar den skrumper.
vokser = not na(osc) and not na(osc[1]) and math.abs(osc) > math.abs(osc[1])
farve  = osc >= 0
     ? (vokser ? color.new(color.green, 0) : color.new(color.green, 55))
     : (vokser ? color.new(color.red,   0) : color.new(color.red,   55))

// ── Plot ────────────────────────────────────────────────────────────────────
// Titlen naevner ikke skalaen — den kan skiftes i indstillingerne.
// display: alt UNDTAGEN price_scale, saa den roede sidste-vaerdi-etiket ikke
// fylder paa y-aksen. Vaerdien staar stadig i status-linjen og Data Window.
plot(osc, "RVOL", style=plot.style_columns, color=farve,
     display = display.pane + display.status_line + display.data_window)

hline(0, "Nul (RVOL = 1)", color=color.new(color.gray, 20), linestyle=hline.style_solid)

// Taerskellinjerne tegnes med plot() frem for hline(), fordi de udledes af
// input-vaerdier og dermed ikke er konstanter.
// Taersklerne foelger den valgte skala, saa linjerne bliver ved med at ligge
// ved de RVOL-vaerdier brugeren har indtastet.
t1 = skala == "Forholdstal" ? niv1 - 1 : math.log(niv1) / math.log(2)
t2 = skala == "Forholdstal" ? niv2 - 1 : math.log(niv2) / math.log(2)
// display.pane: kun selve linjen. Taersklerne er konstanter, saa baade
// akse-etiketten og status-linje-tallet ville blot gentage det der allerede
// staar i indstillingerne.
plot(visNiv ? t1 : na, "Taerskel 1", color=color.new(color.gray, 45),
     style=plot.style_linebr, display = display.pane)
plot(visNiv ? t2 : na, "Taerskel 2", color=color.new(color.gray, 65),
     style=plot.style_linebr, display = display.pane)

// Signallinje — kun hvis man vil have MACD-lookket helt igennem.
// Samme display-regel som hovedplottet, saa den ikke tilfoejer en ny
// akse-etiket naar den slaas til.
sig = ta.ema(osc, sigLen)
plot(visSignal ? sig : na, "Signal", color=color.new(color.orange, 0), linewidth=2,
     display = display.pane + display.status_line + display.data_window)

// ── Alarmer ─────────────────────────────────────────────────────────────────
alertcondition(ta.crossover(rvol, niv1), "RVOL over taerskel 1",
     "RVOL krydsede op gennem taerskel 1")
alertcondition(ta.crossover(rvol, niv2), "RVOL over taerskel 2",
     "RVOL krydsede op gennem taerskel 2 (hale-niveau)")
alertcondition(ta.crossunder(rvol, 1.0), "RVOL under gennemsnittet",
     "RVOL faldt under 1 — volumen under gennemsnittet")
