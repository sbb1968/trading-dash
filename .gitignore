# news_source_bench: hold mappen (via .gitkeep), men ignorer selve rapporterne.
# Undtager netop denne mappe fra backend/*_output/-reglen ovenfor (linje-raekkefoelge
# afgoer: senere regler vinder). En fil kan kun re-inkluderes hvis mappen selv er det.
!backend/news_bench_output/
backend/news_bench_output/*
!backend/news_bench_output/.gitkeep
backend/risk_config.json
backend/regime_fingerprint_output/

# Halt-resumption harvest (spor B, fase 1) — genererbar observations-data
# (matcher ikke backend/*_output/-reglen ovenfor, saa eksplicit linje kraeves)
backend/halt_harvest/

# Store MES-bevaegelser: selve event-datasaettet er afledt data (~75 MB) og
# genskabes med `python backend/analyse_store_bevaegelser.py`.
# Rapporterne + TV-kontrolarket er smaa og committes.
backend/store_bevaegelser_out/*.parquet
backend/store_bevaegelser_out/store_bevaegelser_events.csv
backend/store_bevaegelser_out/store_bevaegelser_baseline.csv
backend/store_bevaegelser_out/store_bevaegelser_baseline_30k.parquet
backend/store_bevaegelser_out/store_bevaegelser_baseline_30k.csv

# Regime-motor v2: mappen daekkes af backend/*_output/ ovenfor, men
# rapporterne ER leverancer og skal med. Selve metrik-serien er afledt
# data (genskabes med regime_backfill.py) og bliver ude.
!backend/regime_v2_output/
backend/regime_v2_output/*
!backend/regime_v2_output/*.md
!backend/regime_v2_output/regime_metrics_daily.csv

# Hvilken af de tilladte konti maskinen handler på lige nu. Maskine-lokal
# tilstand, ligesom risk_config.json — hvidlisten selv står i account.yaml.
backend/aktiv_konto.json
backend/test_aktiv_konto.json

# Algoserverens udgangspunkt under konto 2-testen. Maskine-lokal maaling.
backend/.algoserver_vagt.json
